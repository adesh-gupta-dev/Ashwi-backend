NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ashwi
DB_CONNECTION_LIMIT=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=false

# Authentication: replace with a long, random secret.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# AI provider
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Email and frontend URLs
CLIENT_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_SENDER_EMAIL
SMTP_FROM_NAME=Ashwi

# Register these callbacks with Google and GitHub:
# http://localhost:5000/api/auth/oauth/google/callback
# http://localhost:5000/api/auth/oauth/github/callback
OAUTH_PUBLIC_API_URL=http://localhost:5000
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
