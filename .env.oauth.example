# Append these values to backend/.env. Never copy provider secrets into mobile/.env.
OAUTH_PUBLIC_API_URL=http://localhost:5000
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback

# Google Cloud Console: OAuth client type "Web application".
# Authorized redirect URI: http://localhost:5000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Settings > Developer settings > OAuth Apps.
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
